# ---- Cloud LLM (required) ---------------------------------------------------
# Azure OpenAI: endpoint from the portal (resource -> Keys and Endpoint) + "/openai/v1/"
LLM_BASE_URL=https://<your-resource>.openai.azure.com/openai/v1/
LLM_API_KEY=<your key>
# The DEPLOYMENT name of a chat model that supports function calling
CHAT_MODEL=<your deployment name>

# ---- Optional ---------------------------------------------------------------
# Better web answers (free tier at tavily.com). Leave empty to use free DuckDuckGo search.
TAVILY_API_KEY=
# Require a code before anyone can use the public app. Leave empty to keep it open.
ACCESS_CODE=
# Cap on messages per browser session, to protect your cloud bill
MAX_MESSAGES_PER_SESSION=40
